    {
      "name": "03 - PIX (webhook de entrada)",
      "description": "Simula o provedor PIX notificando a API, com assinatura HMAC.",
      "item": [
        {
          "name": "Receber PIX de R$ 500,00 na conta de origem",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Assina o corpo com HMAC-SHA256, do mesmo jeito que o provedor PIX faria:",
                  "// X-Assinatura: t=<timestamp>,v1=HMAC(segredo, \"<timestamp>.<corpo>\")",
                  "const hmacLib = require('crypto-js');",
                  "function assinar(corpo, segredo) {",
                  "  const t = Math.floor(Date.now() / 1000);",
                  "  const hmac = hmacLib.HmacSHA256(t + '.' + corpo, segredo).toString(hmacLib.enc.Hex);",
                  "  return 't=' + t + ',v1=' + hmac;",
                  "}",
                  "const eventoId = 'pix-' + pm.variables.replaceIn('{{$guid}}');",
                  "const corpo = JSON.stringify({",
                  "  evento_id: eventoId,",
                  "  tipo: 'pix.recebido',",
                  "  conta_id: pm.collectionVariables.get('conta_origem_id'),",
                  "  valor: 50000",
                  "});",
                  "pm.collectionVariables.set('pix_evento_id', eventoId);",
                  "pm.collectionVariables.set('pix_corpo', corpo);",
                  "pm.request.headers.upsert({ key: 'X-Assinatura', value: assinar(corpo, pm.environment.get('pix_webhook_secret')) });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('evento PROCESSADO', () => pm.expect(pm.response.json().status).to.eql('PROCESSADO'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/webhooks/pix",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "pix"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{{pix_corpo}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Reenviar o MESMO PIX (não pode creditar de novo)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Assina o corpo com HMAC-SHA256, do mesmo jeito que o provedor PIX faria:",
                  "// X-Assinatura: t=<timestamp>,v1=HMAC(segredo, \"<timestamp>.<corpo>\")",
                  "const hmacLib = require('crypto-js');",
                  "function assinar(corpo, segredo) {",
                  "  const t = Math.floor(Date.now() / 1000);",
                  "  const hmac = hmacLib.HmacSHA256(t + '.' + corpo, segredo).toString(hmacLib.enc.Hex);",
                  "  return 't=' + t + ',v1=' + hmac;",
                  "}",
                  "const corpo = pm.collectionVariables.get('pix_corpo');",
                  "pm.request.headers.upsert({ key: 'X-Assinatura', value: assinar(corpo, pm.environment.get('pix_webhook_secret')) });"
                ]
              }
            },
            {
              "listen": "test",
