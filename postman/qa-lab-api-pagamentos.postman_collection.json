    {
      "name": "02 - Contas",
      "description": "Cria as duas contas do fluxo com CPFs fictícios gerados no pré-script.",
      "item": [
        {
          "name": "Criar conta de origem",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gera um CPF FICTÍCIO válido (passa no algoritmo, mas não pertence a ninguém)",
                  "function gerarCpf() {",
                  "  const dig = (base) => {",
                  "    const peso = base.length + 1;",
                  "    const soma = base.split('').reduce((acc, d, i) => acc + Number(d) * (peso - i), 0);",
                  "    const resto = (soma * 10) % 11;",
                  "    return resto === 10 ? 0 : resto;",
                  "  };",
                  "  let base;",
                  "  do {",
                  "    base = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10)).join('');",
                  "  } while (/^(\\d)\\1{8}$/.test(base));",
                  "  const d1 = dig(base);",
                  "  return base + d1 + dig(base + d1);",
                  "}",
                  "pm.collectionVariables.set('documento_origem', gerarCpf());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const conta = pm.response.json();",
                  "pm.test('conta criada com saldo zero', () => pm.expect(conta.saldo).to.eql(0));",
                  "pm.test('CPF devolvido mascarado (LGPD)', () => {",
                  "  const cpf = pm.collectionVariables.get('documento_origem');",
                  "  pm.expect(conta.documento_mascarado).to.match(/^\\*\\*\\*\\.\\d{3}\\.\\d{3}-\\*\\*$/);",
                  "  pm.expect(JSON.stringify(conta)).to.not.include(cpf);",
                  "});",
                  "pm.test('header Location aponta para a conta', () => {",
                  "  pm.expect(pm.response.headers.get('Location')).to.eql('/contas/' + conta.id);",
                  "});",
                  "pm.collectionVariables.set('conta_origem_id', conta.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Conta Origem Postman\",\n  \"documento\": \"{{documento_origem}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Criar conta de destino",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gera um CPF FICTÍCIO válido (passa no algoritmo, mas não pertence a ninguém)",
                  "function gerarCpf() {",
                  "  const dig = (base) => {",
                  "    const peso = base.length + 1;",
                  "    const soma = base.split('').reduce((acc, d, i) => acc + Number(d) * (peso - i), 0);",
                  "    const resto = (soma * 10) % 11;",
                  "    return resto === 10 ? 0 : resto;",
                  "  };",
                  "  let base;",
                  "  do {",
                  "    base = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10)).join('');",
                  "  } while (/^(\\d)\\1{8}$/.test(base));",
                  "  const d1 = dig(base);",
                  "  return base + d1 + dig(base + d1);",
                  "}",
                  "pm.variables.set('documento_destino', gerarCpf());"
