{
  "info": {
    "name": "QA Lab — API de Pagamentos (regressão encadeada)",
    "description": "Fluxo de regressão ENCADEADO: cada requisição usa dados gerados pela anterior\n(token → contas → PIX → transferência → estorno → extrato).\n\nRode na ordem (Runner do Postman ou Newman). Todos os dados são fictícios e gerados na hora.\n\nConceitos demonstrados: variáveis de coleção, scripts de pré-requisição (geração de CPF,\nassinatura HMAC), asserções com pm.test, idempotência e encadeamento de respostas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Verificações aplicadas a TODAS as requisições da coleção",
          "pm.test('[geral] tempo de resposta abaixo de 1 segundo', () => {",
          "  pm.expect(pm.response.responseTime).to.be.below(1000);",
          "});",
          "pm.test('[geral] resposta traz X-Request-Id para rastreio', () => {",
          "  pm.response.to.have.header('X-Request-Id');",
          "});",
          "if (pm.response.code !== 204) {",
          "  pm.test('[geral] resposta em JSON', () => {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "  });",
          "}",
          "if (pm.response.code >= 400) {",
          "  pm.test('[geral] erro no formato padrão { erro: { codigo, mensagem } }', () => {",
          "    const corpo = pm.response.json();",
          "    pm.expect(corpo.erro).to.be.an('object');",
          "    pm.expect(corpo.erro.codigo).to.match(/^[A-Z_]+$/);",
          "    pm.expect(corpo.erro.mensagem).to.be.a('string').and.not.empty;",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "conta_origem_id",
