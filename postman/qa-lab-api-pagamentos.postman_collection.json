      "name": "06 - Extrato",
      "description": "Confere o livro-razão da conta de origem ao final do fluxo.",
      "item": [
        {
          "name": "Extrato da conta de origem",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const extrato = pm.response.json();",
                  "pm.test('3 lançamentos: crédito do estorno, débito da transferência e crédito do PIX', () => {",
                  "  const resumo = extrato.lancamentos.map((l) => l.tipo + ':' + l.origem + ':' + l.valor);",
                  "  pm.expect(resumo).to.eql([",
                  "    'CREDITO:ESTORNO:12000',",
                  "    'DEBITO:TRANSFERENCIA:12000',",
                  "    'CREDITO:PIX_RECEBIDO:50000'",
                  "  ]);",
                  "});",
                  "pm.test('saldo do extrato bate com a soma dos lançamentos', () => {",
                  "  const soma = extrato.lancamentos.reduce((acc, l) => acc + (l.tipo === 'CREDITO' ? l.valor : -l.valor), 0);",
                  "  pm.expect(extrato.saldo).to.eql(soma);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contas/{{conta_origem_id}}/extrato?limite=10",
              "host": [
