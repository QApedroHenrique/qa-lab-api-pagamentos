    {
      "name": "04 - Transferências",
      "description": "Transferência com Idempotency-Key, repetição e regras de negócio.",
      "item": [
        {
          "name": "Transferir R$ 120,00 para a conta de destino",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('chave_idempotencia', 'postman-' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const trf = pm.response.json();",
                  "pm.test('transferência CONCLUIDA com os dados enviados', () => {",
                  "  pm.expect(trf.status).to.eql('CONCLUIDA');",
                  "  pm.expect(trf.valor).to.eql(12000);",
                  "  pm.expect(trf.conta_origem_id).to.eql(pm.collectionVariables.get('conta_origem_id'));",
                  "  pm.expect(trf.estornada_em).to.eql(null);",
                  "});",
                  "pm.test('não é uma repetição', () => pm.response.to.not.have.header('Idempotency-Replayed'));",
                  "pm.collectionVariables.set('transferencia_id', trf.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{chave_idempotencia}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transferencias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transferencias"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conta_origem_id\": \"{{conta_origem_id}}\",\n  \"conta_destino_id\": \"{{conta_destino_id}}\",\n  \"valor\": 12000,\n  \"descricao\": \"Teste Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
