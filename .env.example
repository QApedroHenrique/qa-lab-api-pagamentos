# Copie para .env se quiser mudar algum valor. Sem .env, a API usa estes mesmos padrões.
# Todos os valores são FICTÍCIOS e servem só para o ambiente local.

PORT=3000
DATABASE_URL=postgres://qa:qa@localhost:5432/pagamentos

API_CLIENT_ID=qa-lab
API_CLIENT_SECRET=segredo-local-123
JWT_SECRET=jwt-segredo-local
JWT_EXPIRACAO_SEGUNDOS=3600

PIX_WEBHOOK_SECRET=pix-segredo-local
TOLERANCIA_ASSINATURA_SEGUNDOS=300

WEBHOOK_MAX_TENTATIVAS=3
WEBHOOK_INTERVALO_BASE_MS=200
WEBHOOK_TIMEOUT_MS=3000

# Anti-SSRF (RN-16): URLs de webhook para localhost/rede interna são recusadas.
# Libere hosts específicos aqui (separados por vírgula), ex.: para testar com um receptor local.
# WEBHOOK_HOSTS_PERMITIDOS=127.0.0.1

# Em NODE_ENV=production a API NÃO inicia com os segredos padrão acima (RN-15).
# NODE_ENV=production

# A suíte faz TRUNCATE no banco. Fora de localhost/127.0.0.1/db isso é recusado, a menos que:
# PERMITIR_LIMPEZA_BANCO=true

# Opcional: aponta os testes para uma API que já está rodando (pula o setup local)
# BASE_URL=http://localhost:3000
